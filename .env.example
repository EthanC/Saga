LOG_LEVEL=INFO
# Optional warning-and-above forwarding through loguru-discord.
# LOG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/token
LOG_DISCORD_LEVEL=WARNING
PUID=1000
PGID=1000
TZ=Etc/UTC
# Optional path overrides. Leave unset to keep local or Docker defaults.
# SAGA_CONFIG_PATH=config/config.toml
# SAGA_DATA_PATH=data
# SAGA_HEALTHCHECK_FILE=data/healthy
DISCORD_TIMEOUT=30

# Daily SQLite backups; relative directories resolve under SAGA_DATA_PATH.
SAGA_BACKUP_ENABLED=true
SAGA_BACKUP_SCHEDULE=0 7 * * *
SAGA_BACKUP_DIRECTORY=backups
SAGA_BACKUP_RETENTION_COUNT=7
# Optional IANA timezone override; empty uses the system timezone configured by TZ.
SAGA_BACKUP_TIMEZONE=

# Optional, separate from upload notifications and logging.
# REPORT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/token
SAGA_REPORT_SCHEDULE=0 0 * * *
SAGA_REPORT_FINALIZATION_GRACE=300

# Optional full media preservation through the Internet Archive.
# INTERNET_ARCHIVE_EMAIL=user@example.com
# INTERNET_ARCHIVE_PASSWORD=replace-me

# Transfer workers have reserved capacity independent of background jobs.
SAGA_UPLOAD_WORKERS=1
SAGA_DOWNLOAD_WORKERS=1
SAGA_UPLOAD_READY_BUFFER=2
# Space estimate for downloads whose metadata does not include a size.
SAGA_UNKNOWN_DOWNLOAD_BYTES=10000000000
# Optional remote-only validation. Disabled by default for backfills.
SAGA_VALIDATION_ENABLED=false
# Limits for optional background work; required upload recovery retries indefinitely.
SAGA_BACKGROUND_MAX_ATTEMPTS=12
SAGA_BACKGROUND_DEADLINE=86400
SAGA_TRANSFER_STALL_TIMEOUT=900
SAGA_ARCHIVE_RETRY_DELAY=300
SAGA_ARCHIVE_REQUEST_TIMEOUT=60
SAGA_ARCHIVE_POLL_INTERVAL=5
# false keeps only original files: no playable derivatives or thumbnails, and
# fewer tasks in the Archive queue that SlowDown throttling tracks.
SAGA_ARCHIVE_QUEUE_DERIVE=true
# Request the Archive's express task queue for every item write.
SAGA_ARCHIVE_INTERACTIVE_PRIORITY=true
SAGA_MINIMUM_FREE_BYTES=5000000000
# Data-directory download/merge budget in bytes; 0 disables the limit.
# Includes existing downloads, database files, and backups inside SAGA_DATA_PATH.
SAGA_MAX_DATA_BYTES=0
# Combined payload allowances for this Saga process; 0 disables limiting.
SAGA_DOWNLOAD_BYTES_PER_SECOND=0
SAGA_UPLOAD_BYTES_PER_SECOND=0

# Optional YouTube cookies used by yt-dlp. Export guide:
# https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
# YOUTUBE_COOKIES_PATH=config/cookies.txt
# POT is only needed when YouTube cookies are present for authentication.
# Without cookies, the saga-pot container does not need to run.
YOUTUBE_POT_PROVIDER_URL=http://saga-pot:4416

# Optional webpage preservation through Ziggy. Keep its unauthenticated API private.
# ZIGGY_HOST=http://ziggy:9449
# ZIGGY_IDENTIFIER=saga

# Reclaim validated inactive inputs for retention limits or storage pressure.
# Set observe to report only, without deleting inputs.
SAGA_PARTIAL_RETENTION_MODE=auto
SAGA_PARTIAL_MAX_BYTES=100000000000
SAGA_PARTIAL_MIN_AGE=86400

# Compose stop_grace_period must be longer than this application budget.
SAGA_SHUTDOWN_TIMEOUT=90
