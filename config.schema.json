{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EthanC/Saga/main/config.schema.json",
  "title": "Saga configuration",
  "description": "Configuration for Saga's YouTube monitoring instances.",
  "type": "object",
  "additionalProperties": false,
  "required": ["instances"],
  "properties": {
    "instances": {
      "description": "Services monitored by Saga.",
      "type": "object",
      "additionalProperties": false,
      "required": ["youtube"],
      "properties": {
        "youtube": {
          "description": "YouTube monitoring instances.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/youtubeInstance"
          }
        }
      }
    }
  },
  "$defs": {
    "youtubeInstance": {
      "description": "A YouTube polling schedule and its channel routes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "channels"],
      "properties": {
        "name": {
          "description": "Unique lowercase name for this instance.",
          "type": "string",
          "pattern": "^\\s*[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?\\s*$"
        },
        "cooldown": {
          "description": "Seconds between completed scans.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60
        },
        "retries": {
          "description": "Retries allowed for each YouTube request.",
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "retry_delay": {
          "description": "Seconds between retries.",
          "type": "number",
          "minimum": 0,
          "default": 5
        },
        "channels": {
          "description": "Channels monitored by this instance.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/youtubeChannel"
          }
        }
      }
    },
    "youtubeChannel": {
      "description": "A YouTube channel and its Discord notification routes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "discord_webhook_urls"],
      "properties": {
        "reference": {
          "description": "YouTube channel handle, canonical ID, or channel URL.",
          "type": "string",
          "oneOf": [
            {
              "pattern": "^\\s*@[A-Za-z0-9._-]{3,30}\\s*$"
            },
            {
              "pattern": "^\\s*UC[A-Za-z0-9_-]{22}\\s*$"
            },
            {
              "pattern": "^\\s*[hH][tT][tT][pP][sS]://(?:[wW][wW][wW]\\.)?[yY][oO][uU][tT][uU][bB][eE]\\.[cC][oO][mM]/(?:channel/|@|c/|user/)[^?#]*\\s*$"
            }
          ]
        },
        "discord_webhook_urls": {
          "description": "Discord webhooks notified for this channel.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\s*[hH][tT][tT][pP][sS]://(?:[wW][wW][wW]\\.)?[dD][iI][sS][cC][oO][rR][dD]\\.[cC][oO][mM]/api/webhooks/[0-9]+/[^/?#]*[^/?#\\s]\\s*$"
          }
        },
        "videos": {
          "description": "Monitor regular videos.",
          "type": "boolean",
          "default": true
        },
        "shorts": {
          "description": "Monitor Shorts.",
          "type": "boolean",
          "default": true
        },
        "livestreams": {
          "description": "Monitor livestreams.",
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
